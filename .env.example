# Database Configuration
DATABASE_URL=sqlite:///vaani.db

# Flask Configuration
SECRET_KEY=vaani-secret-key-change-in-production
DEBUG=True
FLASK_ENV=development

# Email Configuration (Optional - for NGO approval notifications)
